#include <PID_v1.h>

// Broches driver
const int IN1 = 11;
const int IN2 = 25;

// Encodeur
const int encoderA =21;
const int encoderB =39;
volatile long encoderTicks =0;

// Moteur / Poulie
const float ticksParTourSortie = 960;
const float diametrePoulieCm = 2;
const float circonferencePoulie = 3.1416 * diametrePoulieCm;

// PID
double positionCm = 0;       // Mesure
double positionCibleCm = 0;  // Consigne
double pidOutput = 0;        // Sortie PID

double Kp = 2.1, Ki = 0.001, Kd = 0.01;
PID monPID(&positionCm, &pidOutput, &positionCibleCm, Kp, Ki, Kd, DIRECT);

String inputString = "";
bool nouvelleConsigne = false;
const float toleranceCm = 0.3;


void setup() {
  Serial.begin(9600);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(encoderA, INPUT_PULLUP);
  pinMode(encoderB, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(encoderA), lireEncodeur, CHANGE);

  monPID.SetMode(AUTOMATIC);
  monPID.SetOutputLimits(-53, 53);  // Négatif = arrière, positif = avant

  Serial.println("Entrez une position cible en cm :");
}

void loop() {
  lireConsigneSerie();

  noInterrupts();
  long ticks = encoderTicks;
  interrupts();

  float tours = (float)ticks / ticksParTourSortie;
  positionCm = tours * circonferencePoulie;

  monPID.Compute(); // Calcule la sortie PID

  float erreur = abs(positionCibleCm - positionCm);

  if (erreur < toleranceCm) {
    analogWrite(IN1, 0);
    digitalWrite(IN2, LOW);
  } else {
    int pwm = min(abs(pidOutput), 53);

    // Forcer une vitesse minimale pour garantir le mouvement
    if (pwm < 45) pwm = 53;

    if (pidOutput > 0) {
      analogWrite(IN1, pwm);
      digitalWrite(IN2, LOW);
    } else {
      analogWrite(IN1, 200);
      digitalWrite(IN2, HIGH);
    }
  }

  Serial.print("Pos: ");
  Serial.print(positionCm, 2);
  Serial.print(" | Cible: ");
  Serial.print(positionCibleCm, 2);
  Serial.print(" | PID: ");
  Serial.print(pidOutput);
  Serial.print(" | Ticks: ");
  Serial.println(ticks);

  delay(50);
}

void lireEncodeur() {
  bool A = digitalRead(encoderA);
  bool B = digitalRead(encoderB);
  encoderTicks += (A == B) ? 1 : -1;
}

void lireConsigneSerie() {
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\n') {
      nouvelleConsigne = true;
    } else if (isDigit(c) || c == '.' || c == '-') {
      inputString += c;
    }
  }

  if (nouvelleConsigne) {
    positionCibleCm = inputString.toFloat();
    Serial.print("Nouvelle cible : ");
    Serial.println(positionCibleCm);
    inputString = "";
    nouvelleConsigne = false;
  }
}
