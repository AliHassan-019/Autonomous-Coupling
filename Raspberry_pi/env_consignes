import serial
import time

# Initialisation du port UART
ser = serial.Serial("/dev/ttyAMA0", 9600, timeout=1)
time.sleep(2)  # Laisse le temps au port de s'initialiser

while True:
    # Exemple : consigne pour 6 moteurs (en cm)
    consigne = input("👉 Entrez 6 positions en cm  : ")

    if consigne.lower() == "exit":
        break

    # Vérification basique
    if consigne.count(',') != 5:
        print(" Entrez exactement 6 valeurs séparées par des virgules.")
        continue

    ser.write((consigne + '\n').encode())
    print("✅ Consigne envoyée :", consigne)

    time.sleep(0.1)  # Petite pause

    # Lecture de la réponse éventuelle (facultatif)
    while ser.in_waiting:
        print("🟢 Arduino:", ser.readline().decode(errors='ignore').strip())

ser.close()
